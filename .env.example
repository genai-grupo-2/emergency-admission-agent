# Plantilla de variables para los scripts del grupo.
# El kit actual no carga este archivo automaticamente.
# Para el inicio de sesion local se pueden usar los comandos de SETUP.md.
# Si se copia a .env, ese archivo queda excluido de Git.

# Para los comandos de Python en Windows, si se carga este archivo al ejecutar.
PYTHONUTF8=1

# Token de Hugging Face: lectura para descargar; escritura limitada al repo
# del grupo cuando sea necesario publicar puntos de control.
HF_TOKEN=

# Clave personal de W&B, equipo o usuario y nombre del proyecto.
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=emergency-admission-agent

# Opcionales, para evaluar otras condiciones sin editar configuracion.json
# (ver agente/config.py). No son secretos.
# ADMISION_PROMPT=optimizado
# ADMISION_MODELO_REPO=
# ADMISION_MODELO_REVISION=
# ADMISION_BACKEND=hf
